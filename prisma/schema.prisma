generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  WAITING_FOR_DOCUMENTS
  APPOINTMENT_SCHEDULED
  IN_PROGRESS
  COMPLETED
  LOST
}

enum TrackingCategory {
  PASSPORT_URGENT
  PASSPORT_STANDARD
  OTHER_DOCUMENTS
}

enum PublicTrackingStatus {
  REQUEST_RECEIVED
  DOCUMENTS_UNDER_REVIEW
  READY_FOR_APPOINTMENT_BOOKING
  BIOMETRIC_APPOINTMENT_SCHEDULED
  PROCESSING_WITH_AUTHORITY
  READY_FOR_COLLECTION
  IN_PROCESSING
  READY
}

enum LeadActivityType {
  CREATED
  STATUS_UPDATED
  NOTE_ADDED
  FOLLOW_UP_SET
}

model Lead {
  id                     String         @id @default(cuid())
  fullName               String
  email                  String?
  phone                  String?
  whatsapp               String?
  preferredContactMethod String?
  serviceSlug            String
  serviceName            String
  status                 LeadStatus     @default(NEW)
  trackingReference      String         @unique
  trackingCategory       TrackingCategory?
  trackingOption         String?
  publicTrackingStatus   PublicTrackingStatus?
  publicTrackingNote     String?
  trackingLastUpdatedAt  DateTime?
  message                String?
  formData               Json
  followUpDate           DateTime?
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  notes                  LeadNote[]
  activities             LeadActivity[]

  @@index([serviceSlug])
  @@index([status])
  @@index([deletedAt])
  @@index([trackingReference])
  @@index([createdAt(sort: Desc)])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  type        LeadActivityType
  description String
  createdAt   DateTime         @default(now())
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}


enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum VideoStatus {
  DRAFT
  APPROVED
  QUEUED
  RENDERING
  READY
  FAILED
}

enum DistributionPlatform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
  YOUTUBE
}

enum DistributionStatus {
  DRAFT
  PUBLISHED
}

model ContentPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String
  metaDescription String
  body            String        @db.Text
  serviceSlug     String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  videos          ContentVideo[]

  @@index([status, publishedAt(sort: Desc)])
}

model ContentVideo {
  id              String       @id @default(cuid())
  postId          String
  post            ContentPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  format          String       @default("EXPLAINER")
  hook            String
  script          String       @db.Text
  scenes          Json
  durationSeconds Int          @default(30)
  voice           String       @default("default")
  status          VideoStatus  @default(DRAFT)
  storagePath     String?
  error           String?
  attemptCount    Int          @default(0)
  claimedAt       DateTime?
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  distributions   ContentDistribution[]

  @@index([status, createdAt])
  @@index([postId, createdAt(sort: Desc)])
}

model ContentDistribution {
  id          String               @id @default(cuid())
  videoId     String
  video       ContentVideo         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  platform    DistributionPlatform
  status      DistributionStatus   @default(DRAFT)
  caption     String               @db.Text
  externalUrl String?
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([videoId, platform])
  @@index([platform, status])
}
